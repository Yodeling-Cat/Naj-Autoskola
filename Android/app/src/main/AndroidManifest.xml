<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.spiraclestudios.autoskola"
          android:installLocation="auto">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- For reliable local dispatching on non-Google Play devices. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <supports-screens
        android:xlargeScreens="false" />

    <application
        android:name=".AutoskolaApplication"
        android:allowBackup="true"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/MyTheme.Light">

        <!-- Google Play Services -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <!-- Fabric.io -->
        <meta-data
            android:name="io.fabric.ApiKey"
            android:value="2644eed78272240dcf75b9fcab7b32963b97300f" />

        <!--
         Register AnalyticsReceiver and AnalyticsService to support background
		 dispatching on non-Google Play devices.
        -->
        <receiver
            android:name="com.google.android.gms.analytics.AnalyticsReceiver"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.google.android.gms.analytics.ANALYTICS_DISPATCH" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.google.android.gms.analytics.AnalyticsService"
            android:enabled="true"
            android:exported="false" />

        <activity
            android:name=".activities.MainActivity"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            <activity
			android:name="com.google.android.gms.ads.AdActivity"
			android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
			android:theme="@android:style/Theme.Translucent" />
        -->
        <activity
            android:name=".intros.IntroActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden" />
        <activity
            android:name=".activities.SettingsActivity"
            android:label="@string/title_settings"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.TestActivity"
            android:label="@string/title_tests"
            android:parentActivityName=".activities.MainActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activities.MainActivity" />
        </activity>
        <activity
            android:name=".activities.ResultsActivity"
            android:label="@string/title_tests"
            android:parentActivityName=".activities.MainActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activities.MainActivity" />
        </activity>
        <activity
            android:name=".activities.DatabaseManagerActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.HistoryActivity"
            android:parentActivityName=".activities.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activities.MainActivity" />
        </activity>
        <activity
            android:name=".activities.RoadSignsCategoriesActivity"
            android:label="@string/title_road_signs"
            android:launchMode="singleTask"
            android:parentActivityName=".activities.MainActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activities.MainActivity" />
        </activity>
        <activity
            android:name=".activities.RoadSignsActivity"
            android:label="@string/title_road_signs"
            android:launchMode="singleTask"
            android:parentActivityName=".activities.RoadSignsCategoriesActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activities.RoadSignsCategoriesActivity" />
        </activity>
        <activity
            android:name=".activities.RoadSignsDetailActivity"
            android:label="@string/title_road_signs_detail"
            android:parentActivityName=".activities.RoadSignsActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activities.RoadSignsActivity" />
        </activity>
        <activity
            android:name=".activities.FeedbackActivity"
            android:label="@string/title_help_and_feedback"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.SendFeedbackActivity"
            android:label="@string/title_help_and_feedback"
            android:parentActivityName=".activities.FeedbackActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activities.FeedbackActivity" />
        </activity>
    </application>

</manifest>