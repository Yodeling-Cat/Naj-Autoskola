        android:paddingBottom="@dimen/content_padding_tiny"
        >

      <Button
          android:id="@+id/answer1"
          tools:text="Odpoveď č.1"
          style="@style/AnswerButton"
          />

      <Button
          android:id="@+id/answer2"
          android:layout_marginBottom="@dimen/answer_button_margin"
          android:layout_marginTop="@dimen/answer_button_margin"
          tools:text="Odpoveď č.2"
          style="@style/AnswerButton"
          />

      <Button
          android:id="@+id/answer3"
          tools:text="Odpoveď č.3"
          style="@style/AnswerButton"
          />

    </LinearLayout>-->

    <FrameLayout android:layout_gravity="fill_horizontal">
      <include layout="@layout/partial_answer_buttons_container" />
    </FrameLayout>

  </GridLayout>
</LinearLayout>
