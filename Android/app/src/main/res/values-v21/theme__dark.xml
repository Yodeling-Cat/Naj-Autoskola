  </style>

  <!-- Base.Theme.AppCompat -->
  <style name="Base_AppTheme" parent="Base_V21_AppTheme" />

  <!--
    Widget Themes
  -->

  <style name="Base_DialogTheme_Dark" parent="Base_V21_DialogTheme_Dark" />

  <style name="Base_V21_DialogTheme_Dark" parent="Theme.AppCompat.Dialog.Alert">
    <item name="android:background">?attr/colorDialogBackground</item>
    <item name="colorAccent">?attr/colorAccentFix</item>
  </style>

  <!--
    Content Colors
  -->

  <!-- Answer Button Backgrounds -->
  <color name="colorAnswerNormal__Dark" type="color">@color/grey_300</color>
  <color name="colorAnswerSelected__Dark" type="color">@color/teal_A400</color>
