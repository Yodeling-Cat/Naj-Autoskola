<?xml version="1.0" encoding="utf-8"?>

<resources>

  <!-- Base.V21.Theme.AppCompat.Light -->
  <style name="Base_V21_AppTheme_Light" parent="Base_V7_AppTheme_Light">
    <!-- Widgets -->
    <item name="alertDialogTheme">@style/DialogTheme_Light</item>
    <item name="android:alertDialogTheme">@style/DialogTheme_Light</item>
  </style>

  <!-- Base.Theme.AppCompat.Light -->
  <style name="Base_AppTheme_Light" parent="Base_V21_AppTheme_Light" />

  <!--
    Widget Themes
  -->

  <style name="Base_DialogTheme_Light" parent="Base_V21_DialogTheme_Light" />

  <style name="Base_V21_DialogTheme_Light" parent="Theme.AppCompat.Light.Dialog.Alert">
    <item name="android:background">?attr/colorDialogBackground</item>
    <item name="colorAccent">?attr/colorAccentFix</item>
  </style>

  <!--
    Content Colors
  -->

  <!-- Answer Button Backgrounds -->
  <color name="colorAnswerNormal" type="color">@color/grey_100</color>
  <color name="colorAnswerSelected" type="color">@color/grey_500</color>
  <color name="colorAnswerCorrect" type="color">@color/light_green_500</color>
  <color name="colorAnswerIncorrect" type="color">@color/grey_500</color>

  <!-- Answer Button Text -->
  <color name="colorAnswerTextNormal" type="color">@color/grey_900</color>
  <color name="colorAnswerTextSelected" type="color">#d5ffffff</color>

</resources>