<?xml version="1.0" encoding="utf-8"?>

<!-- Values from each fitting qualifier are applied in-order in which the qualifier increases.
		 If you define the text size in sw360dp and not in sw600dp then on a 600dp device
		 the sw360dp text size will be used. -->
<resources>

	<dimen name="match_parent">-2px</dimen>
	<dimen name="wrap_content">-3px</dimen>

	<!-- Paddings and Margins -->
	<dimen name="edge_horizontal_margin">16dp</dimen>
	<dimen name="edge_vertical_margin">16dp</dimen>

	<dimen name="content_padding_tiny">4dp</dimen>
	<dimen name="content_padding_small">8dp</dimen>
	<dimen name="content_padding">16dp</dimen>
	<dimen name="content_padding_medium">24dp</dimen>
	<dimen name="content_padding_large">32dp</dimen>

	<dimen name="vertical_space">8dp</dimen>
	<dimen name="vertical_space_medium">16dp</dimen>
	<dimen name="vertical_space_large">24dp</dimen>

	<dimen name="fab_margin">16dp</dimen>
	<dimen name="fab_space">86dp</dimen>

	<!-- Elevation when button is pressed -->
	<dimen name="button_elevation_material">1dp</dimen>
	<!-- Z translation to apply when button is pressed -->
	<dimen name="button_pressed_z_material">2dp</dimen>

	<!-- TODO: Create textAppearances for all text in the app and make them slightly bigger on tablets -->
	<!-- Sizes -->
