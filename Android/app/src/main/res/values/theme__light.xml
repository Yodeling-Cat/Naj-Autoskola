<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

  <!-- Platform.AppCompat.Light -->
  <!--<style name="Platform.AppTheme.Light" parent="Platform.AppTheme.Light" />-->

  <!-- Base.V7.Theme.AppCompat.Light -->
  <!--<style name="Base.V7.AppTheme.Light" parent="Platform.AppTheme.Light" />-->
  <style name="Base_V7_AppTheme_Light" parent="Theme.AppCompat.Light.NoActionBar" />

  <!-- Base.Theme.AppCompat.Light -->
  <style name="Base.AppTheme.Light" parent="Base_V7_AppTheme_Light" />



  <!-- Theme.AppCompat.Light -->
  <style name="AppTheme.Light" parent="Base.AppTheme.Light">

    <!--
      Application
    -->

    <item name="colorPrimary">@color/grey_100</item>
    <item name="colorPrimaryDark">@color/grey_300</item>
    <item name="colorAccent">@color/teal_A400</item>
    <item name="colorAccentFix">@color/teal_A400</item>
    <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    <!--<item name="android:windowBackground">@color/reference</item>-->
    <!--<item name="android:navigationBarColor" tools:targetApi="21">@color/</item>-->
    <item name="colorCardBackground">@color/white</item>
    <item name="colorDialogBackground">@color/white</item>

    <!-- Widgets -->
    <item name="alertDialogTheme">@style/DialogTheme_Light</item>
    <item name="android:alertDialogTheme">@style/DialogTheme_Light</item>

    <!-- Navigation Drawer -->
    <item name="colorNavigationDrawerBackground">@color/grey_50</item>
    <item name="colorNavigationDrawerItemIcon">?attr/colorControlNormal</item>
    <item name="colorNavigationDrawerItemIconSelected">?attr/colorAccent</item>
    <item name="colorNavigationDrawerItemIconDisabled">@color/disabled</item>
    <item name="colorNavigationDrawerItemText">@color/black</item>
    <item name="colorNavigationDrawerItemTextDisabled">@color/disabled</item>

    <!-- Text -->
    <item name="colorPrimaryText">@color/primary_text</item>
    <item name="colorPrimaryTextInverse">@color/primary_text__Dark</item>
    <item name="colorSecondaryText">@color/secondary_text</item>
    <item name="colorSecondaryTextInverse">@color/secondary_text__Dark</item>
    <item name="colorHintText">@color/hint_text</item>

    <!-- Icons -->
    <item name="colorIcons">@color/icons</item>
    <item name="colorIconsInverse">@color/icons__Dark</item>
    <item name="colorIconsSecondary">@color/icons_secondary</item>
    <item name="colorIconsSecondaryInverse">@color/icons_secondary__Dark</item>
    <item name="colorToolbarIcons">@color/toolbar_icons</item>

    <!-- Disabled -->
    <item name="colorDisabled">#61000000</item>

    <!-- Dividers -->
    <item name="colorDividers">@color/dividers</item>
    <item name="colorDividersInverse">@color/dividers__Dark</item>

    <!--
      Content
    -->

    <!-- Intersection Car Position Notice -->
    <item name="colorIntersectionCarPositionNotice">@color/grey_300</item>
    <item name="colorIntersectionCarPositionNoticeCloseButton">@color/grey_700</item>

    <!-- Answer Button Backgrounds -->
    <item name="colorAnswerNormal">@color/colorAnswerNormal</item>
    <item name="colorAnswerSelected">@color/colorAnswerSelected</item>
    <item name="colorAnswerCorrect">@color/colorAnswerCorrect</item>
    <item name="colorAnswerIncorrect">@color/colorAnswerIncorrect</item>

    <!-- Answer Button Text -->
    <item name="colorAnswerTextNormal">@color/colorAnswerTextNormal</item>
    <item name="colorAnswerTextSelected">@color/colorAnswerTextSelected</item>

    <!-- Status -->
    <item name="colorPositive">@color/green_600</item>
    <item name="colorNegative">@color/red_500</item>

    <!--
      References
    -->

    <item name="line_divider">@drawable/line_divider</item>

  </style>

  <!--
    Widget Themes
  -->

  <style name="DialogTheme_Light" parent="Theme.AppCompat.Light.Dialog.Alert">
    <item name="android:background">?attr/colorDialogBackground</item>
    <item name="colorAccent">?attr/colorAccentFix</item>
  </style>

  <!--
    Application Colors
  -->

  <!-- Text -->
  <color name="primary_text">#de000000</color>
  <color name="secondary_text">#8a000000</color>
  <color name="hint_text">#60000000</color>

  <!-- Icons -->
  <color name="icons">#8a000000</color>
  <color name="icons_secondary">#6b000000</color>
  <color name="toolbar_icons">#000000</color>

  <!-- Disabled -->
  <color name="disabled">#61000000</color>

  <!-- Dividers -->
  <color name="dividers">#1e000000</color>

  <!--
    Content Colors
  -->

  <!-- Answer Button Backgrounds -->
  <color name="colorAnswerNormal" type="color">@color/grey_300</color>
  <color name="colorAnswerSelected" type="color">@color/grey_500</color>
  <color name="colorAnswerCorrect" type="color">@color/light_green_700</color>
  <color name="colorAnswerIncorrect" type="color">@color/grey_500</color>

  <!-- Answer Button Text -->
  <color name="colorAnswerTextNormal" type="color">@color/grey_900</color>
  <color name="colorAnswerTextSelected" type="color">#d5ffffff</color>

</resources>