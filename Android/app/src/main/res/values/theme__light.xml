<?xml version="1.0" encoding="utf-8"?>

<resources>

  <style name="AppTheme_Light" parent="Base_AppTheme_Light">

    <!--
      Application
    -->

    <item name="colorPrimary">@color/blue_500</item>
    <item name="colorPrimaryDark">@color/blue_700</item>
    <item name="colorAccent">@color/red_A400</item>
    <!--<item name="android:windowBackground">@color/reference</item>-->
    <!--<item name="android:navigationBarColor" tools:targetApi="21">@color/</item>-->
    <item name="navDrawerHeaderBackgroundColor">@color/grey_200</item>
    <item name="cardBackgroundColor">@color/white</item>
    <item name="dialogBackgroundColor">@color/white</item>
    <item name="toolbarTheme">@style/AppTheme_Toolbar_Light</item>
    <item name="alertDialogTheme">@style/AppTheme_AlertDialog</item>

    <!-- Navigation Drawer -->
    <item name="navigationDrawerBackgroundColor">@color/grey_50</item>
    <item name="navigationDrawerItemIconColor">?attr/colorControlNormal</item>
    <item name="navigationDrawerItemIconColorSelected">?attr/colorAccent</item>
    <item name="navigationDrawerItemIconDisabledColor">@color/disabled</item>
    <item name="navigationDrawerItemTextColor">@color/black</item>
    <item name="navigationDrawerItemTextDisabledColor">@color/disabled</item>

    <!-- Text -->
    <item name="toolbarItemColor">?android:attr/textColorPrimaryInverse</item>
    <item name="toolbarItemColorSecondary">?android:attr/textColorSecondaryInverse</item>

    <!-- Icons -->
    <item name="iconColor">@color/icons</item>
    <item name="iconColorInverse">@color/icons__Dark</item>
    <item name="iconColorSecondary">@color/icons_secondary</item>
    <item name="iconColorSecondaryInverse">@color/icons_secondary__Dark</item>

    <!-- Dividers -->
    <item name="dividerColor">@color/dividers</item>
    <item name="dividerColorInverse">@color/dividers__Dark</item>

    <!--
      References
    -->

    <item name="line_divider">@drawable/line_divider</item>

  </style>

  <!--
    Widget Themes
  -->

  <style name="AppTheme_Toolbar_Light" parent="AppTheme_Toolbar">
    <item name="android:textColorPrimary">?attr/toolbarItemColor</item>
    <item name="android:textColorSecondary">?attr/toolbarItemColorSecondary</item>
  </style>

  <!--
    Application Colors
  -->

  <!-- Icons -->
  <color name="icons">#8a000000</color>
  <color name="icons_secondary">#6b000000</color>

  <!-- Disabled -->
  <color name="disabled">#61000000</color>

  <!-- Dividers -->
  <color name="dividers">#1e000000</color>

</resources>