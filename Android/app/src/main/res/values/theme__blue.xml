<?xml version="1.0" encoding="utf-8"?>

<resources>

  <style name="AppTheme_Light.Blue" parent="Base_AppTheme_Light.Blue">

    <!--
      Application
    -->

    <item name="colorPrimary">@color/blue_500</item>
    <item name="colorPrimaryDark">@color/blue_700</item>
    <item name="colorAccent">@color/red_A400</item>
    <item name="colorAccentFix">@color/red_A400</item>

    <!--
      Content
    -->

    <!-- Intersection Car Position Notice -->
    <item name="intersectionCarPositionNoticeColor">@color/grey_300</item>
    <item name="intersectionCarPositionNoticeCloseButtonColor">@color/grey_700</item>

    <!-- Status -->
    <item name="positiveColor">@color/green_600</item>
    <item name="negativeColor">@color/red_500</item>

    <!-- Answer Button Backgrounds -->
    <item name="answerColorNormal">@color/answerColorNormal__Blue</item>
    <item name="answerColorSelected">@color/answerColorSelected__Blue</item>
    <item name="answerColorCorrect">@color/answerColorCorrect__Blue</item>
    <item name="answerColorIncorrect">@color/answerColorIncorrect__Blue</item>

    <!-- Answer Button Text -->
    <item name="answerTextColorNormal">@color/answerTextColorNormal__Blue</item>
    <item name="answerTextColorSelected">@color/answerTextColorSelected__Blue</item>

  </style>

  <!--
    Content Colors
  -->

  <!-- Answer Button Backgrounds -->
  <color name="answerColorNormal__Blue" type="color">@color/grey_300</color>
  <color name="answerColorSelected__Blue" type="color">@color/grey_500</color>
  <color name="answerColorCorrect__Blue" type="color">@color/light_green_700</color>
  <color name="answerColorIncorrect__Blue" type="color">@color/answerColorSelected__Blue</color>

  <!-- Answer Button Text -->
  <color name="answerTextColorNormal__Blue" type="color">@color/grey_900</color>
  <color name="answerTextColorSelected__Blue" type="color">#d5ffffff</color>

</resources>