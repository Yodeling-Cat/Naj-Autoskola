<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

  <style name="AppTheme_Dark" parent="Theme.AppCompat.NoActionBar">

    <!--
      Application
    -->

    <!-- TODO!!! STOP using .Dark in color names, as the rename refactor removes everything behind the dot, resulting in wrong colors being referenced.
     TODO: Fix the damage that has been done. -->

    <item name="colorPrimary">@color/grey_900</item>
    <item name="colorPrimaryDark">#000000</item>
    <item name="colorAccent">@color/teal_A700</item>
    <!--<item name="android:windowBackground">@color/reference</item>-->
    <item name="android:navigationBarColor" tools:targetApi="21">@android:color/black</item>
    <item name="colorCardBackground">@color/grey_800</item>
    <item name="colorDialogBackground">@color/grey_800</item>

    <!-- Widgets -->
    <item name="popupMenuStyle">@style/PopupMenu</item>
    <item name="alertDialogTheme">@style/DialogTheme</item>

    <!-- Navigation Drawer -->
    <item name="colorNavigationDrawerBackground">#303030</item>
    <item name="colorNavigationDrawerItem">?attr/colorControlNormal</item>
    <item name="colorNavigationDrawerItemSelected">?attr/colorAccent</item>
    <item name="colorNavigationDrawerItemDisabled">@color/disabled__Dark</item>

    <!-- Text -->
    <item name="colorPrimaryText">@color/primary_text__Dark</item>
    <item name="colorPrimaryTextInverse">@color/primary_text</item>
    <item name="colorSecondaryText">@color/secondary_text__Dark</item>
    <item name="colorSecondaryTextInverse">@color/secondary_text</item>
    <item name="colorHintText">@color/hint_text__Dark</item>

    <!-- Icons -->
    <item name="colorIcons">@color/icons__Dark</item>
    <item name="colorIconsInverse">@color/icons</item>
    <item name="colorIconsSecondary">@color/icons_secondary__Dark</item>
    <item name="colorIconsSecondaryInverse">@color/icons_secondary</item>
    <item name="colorToolbarIcons">@color/toolbar_icons__Dark</item>

    <!-- Disabled -->
    <item name="colorDisabled">@color/disabled__Dark</item>

    <!-- Dividers -->
    <item name="colorDividers">@color/dividers__Dark</item>
    <item name="colorDividersInverse">@color/dividers</item>

    <!--
      Content
    -->

    <!-- Intersection Car Position Notice -->
    <item name="colorIntersectionCarPositionNotice">@color/grey_800</item>
    <item name="colorIntersectionCarPositionNoticeCloseButton">@color/grey_400</item>

    <!-- Answer Button Backgrounds -->
    <item name="colorAnswerNormal">@color/colorAnswerNormal__Dark</item>
    <item name="colorAnswerSelected">@color/colorAnswerSelected__Dark</item>
    <item name="colorAnswerCorrect">@color/colorAnswerCorrect__Dark</item>
    <item name="colorAnswerIncorrect">@color/colorAnswerIncorrect__Dark</item>

    <!-- Answer Button Text -->
    <item name="colorAnswerTextNormal">@color/colorAnswerTextNormal__Dark</item>
    <item name="colorAnswerTextSelected">@color/colorAnswerTextSelected__Dark</item>

    <!-- Status -->
    <item name="colorPositive">@color/light_green_A700</item>
    <item name="colorNegative">@color/red_500</item>

    <!--
      References
    -->

    <item name="line_divider">@drawable/line_divider__dark</item>

  </style>

  <!--
    Application Colors
  -->

  <!-- Text -->
  <color name="primary_text__Dark">#ffffff</color>
  <color name="secondary_text__Dark">#b2ffffff</color>
  <color name="hint_text__Dark">#4cffffff</color>

  <!-- Icons -->
  <color name="icons__Dark">#ffffff</color>
  <color name="icons_secondary__Dark">#bfffffff</color>
  <color name="toolbar_icons__Dark">#ffffff</color>

  <!-- Disabled -->
  <color name="disabled__Dark">#80ffffff</color>

  <!-- Dividers -->
  <color name="dividers__Dark">#1effffff</color>

  <!--
    Content Colors
  -->

  <!-- Answer Button Backgrounds -->
  <color name="colorAnswerNormal__Dark" type="color">@color/grey_700</color>
  <color name="colorAnswerSelected__Dark" type="color">@color/cyan_800</color>
  <color name="colorAnswerCorrect__Dark" type="color">@color/light_green_700</color>
  <color name="colorAnswerIncorrect__Dark" type="color">@color/cyan_800</color>

  <!-- Answer Button Text -->
  <color name="colorAnswerTextNormal__Dark" type="color">#ffffff</color>
  <color name="colorAnswerTextSelected__Dark" type="color">#ffffff</color>

</resources>