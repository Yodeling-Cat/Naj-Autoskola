<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

  <style name="AppTheme_Dark" parent="Theme.AppCompat.NoActionBar">
    <!-- Application Colors -->
    <item name="colorPrimary">@color/colorPrimary.Dark</item>
    <item name="colorPrimaryDark">@color/colorPrimaryDark.Dark</item>
    <item name="colorAccent">@color/colorAccent.Dark</item>
    <!--<item name="android:windowBackground">@color/colorWindowBackground.Dark</item>-->
    <item name="android:navigationBarColor" tools:targetApi="21">@android:color/black</item>
    <!--<item name="colorCardBackground">@color/colorCardBackground.Dark</item>-->
    <item name="colorDialogBackground">@color/colorDialogBackground.Dark</item>

    <!-- Custom Widget Styles -->
    <item name="android:alertDialogTheme">@style/DialogTheme</item>

    <!-- Navigation Drawer Items -->
    <item name="colorNavigationDrawerBackground">@color/colorNavigationDrawerBackground.Dark</item>
    <item name="colorNavigationDrawerItem">?attr/colorControlNormal</item>
    <item name="colorNavigationDrawerItemSelected">?attr/colorAccent</item>
    <item name="colorNavigationDrawerItemDisabled">@color/colorDisabled.Dark</item>

    <!-- Text -->
    <item name="colorPrimaryText">@color/colorPrimaryText.Dark</item>
    <item name="colorPrimaryTextInverse">@color/colorPrimaryText</item>
    <item name="colorSecondaryText">@color/colorSecondaryText.Dark</item>
    <item name="colorSecondaryTextInverse">@color/colorSecondaryText</item>
    <item name="colorHintText">@color/colorHintText.Dark</item>

    <!-- Icons -->
    <item name="colorIcons">@color/colorIcons.Dark</item>
    <item name="colorIconsInverse">@color/colorIcons</item>
    <item name="colorIconsSecondary">@color/colorIconsSecondary.Dark</item>
    <item name="colorIconsSecondaryInverse">@color/colorIconsSecondary</item>
    <item name="colorToolbarIcons">@color/colorToolbarIcons.Dark</item>

    <!--
      Misc
    -->

    <!-- Disabled -->
    <item name="colorDisabled">@color/colorDisabled.Dark</item>

    <!-- Dividers -->
    <item name="colorDividers">@color/colorDividers.Dark</item>
    <item name="colorDividersInverse">@color/colorDividers</item>

    <!-- Intersection Car Position Notice -->
    <item name="colorIntersectionCarPositionNotice">@color/colorIntersectionCarPositionNotice.Dark
    </item>
    <item name="colorIntersectionCarPositionNoticeCloseButton">
      @color/colorIntersectionCarPositionNoticeCloseButton.Dark
    </item>

    <!-- Answer Button Backgrounds -->
    <item name="colorAnswerNormal">@color/colorAnswerNormal.Dark</item>
    <item name="colorAnswerSelected">@color/colorAnswerSelected.Dark</item>
    <item name="colorAnswerCorrect">@color/colorAnswerCorrect.Dark</item>
    <item name="colorAnswerIncorrect">@color/colorAnswerIncorrect.Dark</item>

    <!-- Answer Button Text -->
    <item name="colorAnswerTextNormal">@color/colorAnswerTextNormal.Dark</item>
    <item name="colorAnswerTextSelected">@color/colorAnswerTextSelected.Dark</item>

    <!-- Status -->
    <item name="colorPositive">@color/colorPositive.Dark</item>
    <item name="colorNegative">@color/colorNegative.Dark</item>

    <!--
      REFERENCES
    -->

    <item name="line_divider">@drawable/line_divider_dark</item>
  </style>

  <!--
    Colors
  -->

  <!-- Application Colors -->
  <color name="colorPrimary.Dark">@color/grey_900</color>
  <color name="colorPrimaryDark.Dark">#000000</color>
  <color name="colorAccent.Dark">@color/teal_A700</color>
  <!--<color name="colorWindowBackground.Dark">@color/</color>-->
  <color name="colorDialogBackground.Dark">@color/grey_800</color>

  <!-- Navigation Drawer -->
  <color name="colorNavigationDrawerBackground.Dark">#303030</color>

  <!-- Text -->
  <color name="colorPrimaryText.Dark">#ffffff</color>
  <color name="colorSecondaryText.Dark">#b2ffffff</color>
  <color name="colorHintText.Dark">#4cffffff</color>

  <!-- Icons -->
  <color name="colorIcons.Dark">#ffffff</color>
  <color name="colorIconsSecondary.Dark">#bfffffff</color>
  <color name="colorToolbarIcons.Dark">#ffffff</color>

  <!--
    Misc
  -->

  <!-- Disabled -->
  <color name="colorDisabled.Dark">#80ffffff</color>

  <!-- Dividers -->
  <color name="colorDividers.Dark">#1effffff</color>

  <!-- Answer Button Backgrounds -->
  <color name="colorAnswerNormal.Dark">@color/grey_700</color>
  <color name="colorAnswerSelected.Dark">@color/cyan_800</color>
  <color name="colorAnswerCorrect.Dark">@color/light_green_700</color>
  <color name="colorAnswerIncorrect.Dark">@color/cyan_800</color>

  <!-- Answer Button Text -->
  <color name="colorAnswerTextNormal.Dark">#ffffff</color>
  <color name="colorAnswerTextSelected.Dark">#ffffff</color>

  <!-- Intersection Car Position Notice -->
  <color name="colorIntersectionCarPositionNotice.Dark">@color/grey_800</color>
  <color name="colorIntersectionCarPositionNoticeCloseButton.Dark">@color/grey_400
  </color>

  <!-- Status -->
  <color name="colorPositive.Dark">@color/light_green_A700</color>
  <color name="colorNegative.Dark">@color/red_500</color>

</resources>