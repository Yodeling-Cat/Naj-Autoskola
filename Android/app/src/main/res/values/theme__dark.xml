<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

  <style name="AppTheme_Dark" parent="Base_AppTheme">

    <!--
      Application
    -->

    <item name="colorPrimary">@color/grey_900</item>
    <item name="colorPrimaryDark">#000000</item>
    <item name="colorAccent">@color/teal_A700</item>
    <!--<item name="android:windowBackground">@color/reference</item>-->
    <item name="android:navigationBarColor" tools:targetApi="21">@android:color/black</item>
    <item name="navDrawerHeaderBackgroundColor">@color/grey_800</item>
    <item name="cardBackgroundColor">@color/grey_800</item>
    <item name="dialogBackgroundColor">@color/grey_800</item>
    <item name="toolbarTheme">@style/AppTheme_Toolbar_Dark</item>
    <item name="alertDialogTheme">@style/AppTheme_AlertDialog</item>

    <!-- Navigation Drawer -->
    <item name="navigationDrawerBackgroundColor">#303030</item>
    <item name="navigationDrawerItemIconColor">?attr/colorControlNormal</item>
    <item name="navigationDrawerItemIconColorSelected">?attr/colorAccent</item>
    <item name="navigationDrawerItemIconDisabledColor">@color/disabled__Dark</item>
    <item name="navigationDrawerItemTextColor">@color/white</item>
    <item name="navigationDrawerItemTextDisabledColor">@color/disabled__Dark</item>

    <!-- Text -->
    <item name="toolbarItemColor">?android:attr/textColorPrimary</item>
    <item name="toolbarItemColorSecondary">?android:attr/textColorSecondary</item>

    <!-- Icons -->
    <item name="iconColor">@color/icons__Dark</item>
    <item name="iconColorInverse">@color/icons</item>
    <item name="iconColorSecondary">@color/icons_secondary__Dark</item>
    <item name="iconColorSecondaryInverse">@color/icons_secondary</item>

    <!-- Dividers -->
    <item name="dividerColor">@color/dividers__Dark</item>
    <item name="dividerColorInverse">@color/dividers</item>

    <!--
      References
    -->

    <item name="line_divider">@drawable/line_divider__dark</item>

  </style>

  <!--
    Widget Themes
  -->

  <style name="AppTheme_Toolbar_Dark" parent="AppTheme_Toolbar" />

  <!--
    Application Colors
  -->

  <!-- Icons -->
  <color name="icons__Dark">#ffffff</color>
  <color name="icons_secondary__Dark">#bfffffff</color>

  <!-- Disabled -->
  <color name="disabled__Dark">#80ffffff</color>

  <!-- Dividers -->
  <color name="dividers__Dark">#1effffff</color>

</resources>