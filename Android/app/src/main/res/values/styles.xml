<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

  <!--
    ~~~ LIGHT THEME ~~~
  -->

  <style name="AppTheme_Light" parent="@style/Theme.AppCompat.Light.NoActionBar">
    <!-- Application Colors -->
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
    <item name="colorAccent">@color/colorAccent</item>
    <item name="colorNavigationDrawerBackground">@color/colorNavigationDrawerBackground</item>

    <!-- Navigation Drawer Items -->
    <item name="colorNavigationDrawerItem">?attr/colorControlNormal</item>
    <item name="colorNavigationDrawerItemSelected">?attr/colorPrimary</item>
    <item name="colorNavigationDrawerItemDisabled">@color/colorDisabled</item>

    <!-- Text -->
    <item name="colorPrimaryText">@color/colorPrimaryText</item>
    <item name="colorPrimaryTextInverse">@color/colorPrimaryTextInverse</item>
    <item name="colorSecondaryText">@color/colorSecondaryText</item>
    <item name="colorSecondaryTextInverse">@color/colorSecondaryTextInverse</item>
    <item name="colorHintText">@color/colorHintText</item>

    <!-- Icons -->
    <item name="colorIcons">@color/colorIcons</item>
    <item name="colorIconsInverse">@color/colorIconsInverse</item>
    <item name="colorIconsLight">@color/colorIconsLight</item>

    <!--
      ~ Misc
    -->

    <!-- Disabled -->
    <item name="colorDisabled">@color/colorDisabled</item>

    <!-- Dividers -->
    <item name="colorDividers">@color/colorDividers</item>
    <item name="colorDividersInverse">@color/colorDividersInverse</item>

    <!-- Intersection Car Position Notice -->
    <item name="colorIntersectionCarPositionNotice">@color/colorIntersectionCarPositionNotice</item>
    <item name="colorIntersectionCarPositionNoticeCloseButton">
      @color/colorIntersectionCarPositionNoticeCloseButton
    </item>

    <!-- Answer Button Backgrounds -->
    <item name="colorAnswerNormal">@color/colorAnswerNormal</item>
    <item name="colorAnswerSelected">@color/colorAnswerSelected</item>
    <item name="colorAnswerCorrect">@color/colorAnswerCorrect</item>
    <item name="colorAnswerIncorrect">@color/colorAnswerIncorrect</item>

    <!-- Answer Button Text -->
    <item name="colorAnswerTextNormal">@color/colorAnswerTextNormal</item>
    <item name="colorAnswerTextSelected">@color/colorAnswerTextSelected</item>

    <!-- Status -->
    <item name="colorPositive">@color/colorPositive</item>
    <item name="colorNegative">@color/colorNegative</item>

    <!--
      ~ REFERENCES
    -->

    <item name="line_divider">@drawable/line_divider</item>
  </style>

  <!--
    ~~~ DARK THEME ~~~
  -->

  <style name="AppTheme_Dark" parent="@style/Theme.AppCompat.NoActionBar">
    <item name="android:navigationBarColor" tools:targetApi="21">@android:color/black</item>

    <!-- Application Colors -->
    <item name="colorPrimary">@color/colorPrimary.Dark</item>
    <item name="colorPrimaryDark">@color/colorPrimaryDark.Dark</item>
    <item name="colorAccent">@color/colorAccent.Dark</item>
    <item name="colorNavigationDrawerBackground">@color/colorNavigationDrawerBackground.Dark</item>

    <!-- Navigation Drawer Items -->
    <item name="colorNavigationDrawerItem">?attr/colorControlNormal</item>
    <item name="colorNavigationDrawerItemSelected">?attr/colorAccent</item>
    <item name="colorNavigationDrawerItemDisabled">@color/colorDisabled.Dark</item>

    <!-- Text -->
    <item name="colorPrimaryText">@color/colorPrimaryText.Dark</item>
    <item name="colorPrimaryTextInverse">@color/colorPrimaryTextInverse.Dark</item>
    <item name="colorSecondaryText">@color/colorSecondaryText.Dark</item>
    <item name="colorSecondaryTextInverse">@color/colorSecondaryTextInverse.Dark</item>
    <item name="colorHintText">@color/colorHintText.Dark</item>

    <!-- Icons -->
    <item name="colorIcons">@color/colorIcons.Dark</item>
    <item name="colorIconsInverse">@color/colorIconsInverse.Dark</item>
    <item name="colorIconsLight">@color/colorIconsLight.Dark</item>

    <!--
      ~ Misc
    -->

    <!-- Disabled -->
    <item name="colorDisabled">@color/colorDisabled.Dark</item>

    <!-- Dividers -->
    <item name="colorDividers">@color/colorDividers.Dark</item>
    <item name="colorDividersInverse">@color/colorDividersInverse.Dark</item>

    <!-- Intersection Car Position Notice -->
    <item name="colorIntersectionCarPositionNotice">@color/colorIntersectionCarPositionNotice.Dark</item>
    <item name="colorIntersectionCarPositionNoticeCloseButton">
      @color/colorIntersectionCarPositionNoticeCloseButton.Dark
    </item>

    <!-- Answer Button Backgrounds -->
    <item name="colorAnswerNormal">@color/colorAnswerNormal.Dark</item>
    <item name="colorAnswerSelected">@color/colorAnswerSelected.Dark</item>
    <item name="colorAnswerCorrect">@color/colorAnswerCorrect.Dark</item>
    <item name="colorAnswerIncorrect">@color/colorAnswerIncorrect.Dark</item>

    <!-- Answer Button Text -->
    <item name="colorAnswerTextNormal">@color/colorAnswerTextNormal.Dark</item>
    <item name="colorAnswerTextSelected">@color/colorAnswerTextSelected.Dark</item>

    <!-- Status -->
    <item name="colorPositive">@color/colorPositive.Dark</item>
    <item name="colorNegative">@color/colorNegative.Dark</item>

    <!--
      ~ REFERENCES
    -->

    <item name="line_divider">@drawable/line_divider_dark</item>
  </style>

  <!--
      Sub Themes
  -->

  <style name="AppTheme_AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

  <style name="AppTheme_PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

  <style name="AppTheme_Splash" parent="Theme.AppCompat.Light">
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowBackground">@drawable/splash_screen</item>
  </style>

  <!--
      Standard Android Views
  -->

  <style name="NavigationDrawer">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">match_parent</item>
    <item name="android:layout_gravity">start</item>
    <item name="android:fitsSystemWindows">true</item>
    <!--<item name="headerLayout">@layout/global__nav_header</item>-->
    <item name="menu">@menu/global__navigation_drawer</item>
  </style>

  <style name="DrawerLayout">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">match_parent</item>
    <item name="android:fitsSystemWindows">true</item>
  </style>

  <style name="NavigationView" parent="Widget.Design.NavigationView">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">match_parent</item>
    <item name="android:layout_gravity">start</item>
    <item name="android:background">?attr/colorNavigationDrawerBackground</item>
    <item name="android:fitsSystemWindows">true</item>
    <item name="menu">@menu/global__navigation_drawer</item>
    <item name="itemIconTint">@color/navigation_drawer_item</item>
    <item name="itemTextColor">@color/navigation_drawer_item</item>
    <!--<item name="headerLayout">@layout/partial_nav_header_main</item>-->
    <!--<item name="android:layout_marginTop">?attr/actionBarSize>-->
  </style>

  <style name="CoordinatorLayout" parent="Widget.Design.CoordinatorLayout">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">match_parent</item>
  </style>

  <style name="AppBarLayout" parent="Widget.Design.AppBarLayout">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:theme">@style/AppTheme_AppBarOverlay</item>
  </style>

  <style name="Toolbar" parent="Widget.AppCompat.Toolbar">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">?attr/actionBarSize</item>
    <item name="android:background">?attr/colorPrimary</item>
    <item name="popupTheme">@style/AppTheme_PopupOverlay</item>
  </style>

  <!--
      Miscellaneous
  -->

  <style name="AnswerButton" parent="@android:style/Widget.DeviceDefault.Button">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:padding">@dimen/answer_button_padding</item>
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:textColor">@color/grey_900</item>
    <item name="android:textSize">@dimen/answer_button_text_size</item>
    <item name="android:gravity">start|center_vertical</item>
    <item name="android:textAllCaps">false</item>
  </style>

