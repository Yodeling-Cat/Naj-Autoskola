	<!-- Used by IntroActivity to get white text color -->
	<style name="IntroSlide">
		<item name="android:textColor">#fff</item>
	</style>

	<style name="IntroSlideActionButton">
		<item name="colorButtonNormal">@color/yellow_500</item>
		<item name="android:padding">20dp</item>
		<item name="android:textColor">@color/primary_text</item>
		<!--<item name="android:textStyle">bold</item>-->
	</style>

	<style name="IntroSlideTextInputLayout">
		<!-- Hint and label color in FALSE state -->
		<item name="android:textColor">?attr/colorPrimaryText</item>
		<item name="android:textColorHint">#7fffffff</item>
		<!-- Label color in TRUE state and bar color States -->
		<item name="colorControlNormal">#7fffffff</item>
		<item name="colorControlActivated">@color/yellow_500</item>
	</style>

	<style name="ShowcaseTheme.Light" parent="ShowcaseView.Light">
		<item name="sv_backgroundColor">#961249d9</item>
		<item name="sv_showcaseColor">@color/light_blue_600</item>
		<!--<item name="sv_titleTextAppearance">@style/CustomTitle</item>-->
		<item name="sv_detailTextAppearance">@style/ShowcaseTheme.Detail.Light</item>
	</style>

	<style name="ShowcaseTheme" parent="ShowcaseView">
		<item name="sv_backgroundColor">#e51249d9</item>
		<item name="sv_showcaseColor">#25467A</item>
		<!--<item name="sv_titleTextAppearance">@style/CustomTitle2</item>-->
		<!--<item name="sv_detailTextAppearance">@style/ShowcaseTheme.Detail.Light</item>-->
	</style>

	<style name="ShowcaseTheme.Title" parent="TextAppearance.ShowcaseView.Title">
		<item name="android:textColor">@color/light_blue_A200</item>
	</style>

	<style name="ShowcaseTheme.Title.Light" parent="TextAppearance.ShowcaseView.Title.Light">
		<item name="android:textColor">@color/light_blue_A200</item>
	</style>

	<style name="ShowcaseTheme.Detail.Light" parent="TextAppearance.ShowcaseView.Detail.Light">
		<item name="android:textColor">#8affffff</item>
	</style>

	<!--
      Standard Android Views
  -->

	<style name="NavigationView" parent="Widget.Design.NavigationView">
		<item name="android:layout_width">wrap_content</item>
		<item name="android:layout_height">match_parent</item>
		<item name="android:layout_gravity">start</item>
		<item name="android:background">?attr/colorNavigationDrawerBackground</item>
		<item name="android:fitsSystemWindows">true</item>
		<item name="menu">@menu/global__navigation_drawer</item>
		<item name="itemIconTint">@color/navigation_drawer_item</item>
		<item name="itemTextColor">@color/navigation_drawer_item</item>
		<!--<item name="headerLayout">@layout/partial_nav_header_main</item>-->
		<!--<item name="android:layout_marginTop">?attr/actionBarSize>-->
	</style>

	<style name="CoordinatorLayout" parent="Widget.Design.CoordinatorLayout">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">match_parent</item>
	</style>

	<style name="AppBarLayout" parent="Widget.Design.AppBarLayout">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:theme">@style/AppTheme_AppBarOverlay</item>
	</style>

	<style name="Toolbar" parent="Widget.AppCompat.Toolbar">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">?attr/actionBarSize</item>
		<item name="android:background">?attr/colorPrimary</item>
		<item name="popupTheme">@style/AppTheme_PopupOverlay</item>
	</style>

	<!--
      Miscellaneous
  -->

	<style name="Activity_Footer_Text">
		<item name="android:layout_gravity">center_horizontal</item>
		<item name="android:layout_marginTop">@dimen/content_padding_small</item>
		<item name="android:textColor">?attr/colorSecondaryText</item>
	</style>

	<style name="IntersectionCarPositionNotice">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:gravity">center_vertical</item>
		<item name="android:padding">@dimen/content_padding_small</item>
		<item name="android:background">?attr/colorIntersectionCarPositionNotice</item>
	</style>

	<style name="IntersectionCarPositionNoticeText">
		<item name="android:layout_weight">1</item>
		<item name="android:layout_width">0dp</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:layout_marginRight">@dimen/content_padding_small</item>
		<item name="android:textSize">@dimen/intersection_car_position_notice_text_size</item>
		<item name="android:textColor">?attr/colorPrimaryText</item>
	</style>

	<style name="IntersectionCarPositionNoticeClose" parent="@style/Icon.Selectable">
		<item name="android:layout_width">32dp</item>
		<item name="android:layout_height">32dp</item>
		<item name="srcCompat">@drawable/ic_close_black_24dp</item>
		<item name="android:tint">?attr/colorIntersectionCarPositionNoticeClose</item>
	</style>

	<style name="Divider">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">@dimen/divider_height</item>
		<item name="android:layout_marginTop">@dimen/content_padding</item>
		<item name="android:layout_marginBottom">@dimen/content_padding</item>
		<item name="android:background">?attr/colorDividers</item>
	</style>

	<style name="Divider.Small">
		<item name="android:layout_marginTop">@dimen/content_padding_small</item>
		<item name="android:layout_marginBottom">@dimen/content_padding_small</item>
	</style>

	<style name="VerticalSpace">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">@dimen/vertical_space</item>
	</style>

	<!--
      Paper Views
  -->

	<style name="PaperSheet" parent="CardView">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="cardUseCompatPadding">true</item>
		<item name="cardCornerRadius">0dp</item>
		<item name="android:layout_marginTop">-4dp</item>
		<item name="android:layout_marginLeft">-3dp</item>
		<item name="android:layout_marginRight">-3dp</item>
	</style>

	<!--
      Icons
  -->

	<style name="Icon">
		<item name="android:layout_width">36dp</item>
		<item name="android:layout_height">36dp</item>
		<item name="android:tint">?attr/colorIconsLight</item>
	</style>

	<style name="Icon.Selectable">
		<item name="android:background">?attr/selectableItemBackgroundBorderless</item>
	</style>

	<style name="SocialIcon" parent="Icon.Selectable">
		<item name="android:layout_margin">@dimen/content_padding_tiny</item>
	</style>

	<!--
      Text Appearances
  -->

	<style name="TextAppearance" parent="TextAppearance.AppCompat.Small"/>

	<style name="TextAppearance.Content_Category_Header">
		<item name="android:textColor">?android:attr/textColorPrimary</item>
		<item name="android:textSize">16sp</item>
		<item name="android:textStyle">bold</item>
	</style>

	<style name="TextAppearance.Content_Category_Header_AdditionalInfo">
		<item name="android:textSize">13sp</item>
	</style>

	<style name="TextAppearance.Content_Pair_Key">
		<item name="android:textColor">?android:attr/textColorPrimary</item>
		<item name="android:textSize">15sp</item>
	</style>

	<style name="TextAppearance.Content_Pair_Value"/>

</resources>