<resources xmlns:tools="http://schemas.android.com/tools">

	<style name="AppTheme_AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

	<style name="AppTheme_PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

	<style name="AppTheme_Light" parent="@style/Theme.AppCompat.Light.NoActionBar">
		<item name="colorPrimary">@color/primary</item>
		<item name="colorPrimaryDark">@color/primary_dark</item>
		<item name="colorSecondary">@color/secondary</item>
		<item name="colorSecondaryDark">@color/secondary_dark</item>
		<item name="colorAccent">@color/accent</item>
		<item name="colorFlatButtons">@color/accent</item>
		<item name="colorNavigationDrawerBackground">@color/grey_50</item>

		<item name="colorNavigationDrawerItem">?attr/colorControlNormal</item>
		<item name="colorNavigationDrawerItemSelected">?attr/colorPrimary</item>
		<item name="colorNavigationDrawerItemDisabled">@color/disabled</item>

		<!-- Answer Buttons -->
		<item name="colorAnswerNormal">@color/answer_normal</item>
		<item name="colorAnswerSelected">@color/answer_selected</item>
		<item name="colorAnswerCorrect">@color/answer_correct</item>
		<item name="colorAnswerIncorrect">@color/answer_incorrect</item>
		<item name="colorAnswerNormalText">@color/answer_normal_text</item>
		<item name="colorAnswerSelectedText">@color/answer_selected_text</item>

		<item name="colorCorrectText">@color/correct_text</item>
		<item name="colorIncorrectText">@color/incorrect_text</item>

		<!-- Text, Icons, Dividers -->
		<item name="colorPrimaryText">@color/primary_text</item>
		<item name="colorPrimaryTextInverse">@color/primary_text_inverse</item>
		<item name="colorSecondaryText">@color/secondary_text</item>
		<item name="colorSecondaryTextInverse">@color/secondary_text_inverse</item>
		<item name="colorIcons">@color/icons</item>
		<item name="colorIconsLight">@color/colorIconsLight</item>
		<item name="colorDisabled">@color/disabled</item>
		<item name="colorHintText">@color/hint_text</item>
		<item name="colorDividers">@color/dividers</item>

		<item name="colorIntersectionCarPositionNotice">@color/grey_300</item>
		<item name="colorIntersectionCarPositionNoticeClose">@color/grey_700</item>

		<!-- References -->
		<item name="line_divider">@drawable/line_divider</item>
	</style>

	<style name="AppTheme_Dark" parent="@style/Theme.AppCompat.NoActionBar">
		<item name="android:navigationBarColor" tools:targetApi="21">#000</item>
		<item name="colorPrimary">@color/primary.Dark</item>
		<item name="colorPrimaryDark">@color/primary_dark.Dark</item>
		<item name="colorSecondary">@color/secondary.Dark</item>
		<item name="colorSecondaryDark">@color/secondary_dark.Dark</item>
		<item name="colorAccent">@color/accent.Dark</item>
		<item name="colorFlatButtons">@color/accent.Dark</item>
		<item name="colorNavigationDrawerBackground">#303030</item>

		<item name="colorNavigationDrawerItem">?attr/colorControlNormal</item>
		<item name="colorNavigationDrawerItemSelected">?attr/colorAccent</item>
		<item name="colorNavigationDrawerItemDisabled">@color/disabled.Dark</item>

		<!-- Answer Buttons -->
		<item name="colorAnswerNormal">@color/answer_normal.Dark</item>
		<item name="colorAnswerSelected">@color/answer_selected.Dark</item>
		<item name="colorAnswerCorrect">@color/answer_correct.Dark</item>
		<item name="colorAnswerIncorrect">@color/answer_incorrect.Dark</item>
		<item name="colorAnswerNormalText">@color/answer_normal_text.Dark</item>
		<item name="colorAnswerSelectedText">@color/answer_selected_text.Dark</item>

		<item name="colorCorrectText">@color/correct_text.Dark</item>
		<item name="colorIncorrectText">@color/incorrect_text.Dark</item>

		<!-- Text, Icons, Dividers -->
		<item name="colorPrimaryText">@color/primary_text.Dark</item>
		<item name="colorPrimaryTextInverse">@color/primary_text_inverse.Dark</item>
		<item name="colorSecondaryText">@color/secondary_text.Dark</item>
		<item name="colorSecondaryTextInverse">@color/secondary_text_inverse.Dark</item>
		<item name="colorIcons">@color/icons.Dark</item>
		<item name="colorIconsLight">@color/colorIconsLight.Dark</item>
		<item name="colorDisabled">@color/disabled.Dark</item>
		<item name="colorHintText">@color/hint_text.Dark</item>
		<item name="colorDividers">@color/dividers.Dark</item>

		<item name="colorIntersectionCarPositionNotice">@color/grey_800</item>
		<item name="colorIntersectionCarPositionNoticeClose">@color/grey_400</item>

		<!-- References -->
		<item name="line_divider">@drawable/line_divider_dark</item>
	</style>

	<style name="AppTheme_Splash" parent="Theme.AppCompat.Light">
		<item name="android:windowBackground">@drawable/splash_screen</item>
		<item name="android:windowNoTitle">true</item>
	</style>

	<style name="AnswerButton">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:padding">@dimen/answer_button_padding</item>
		<item name="android:fontFamily">sans-serif</item>
		<item name="android:textColor">@color/grey_900</item>
		<item name="android:textSize">@dimen/answer_button_text_size</item>
		<item name="android:gravity">start|center_vertical</item>
		<item name="android:textAllCaps">false</item>
	</style>

