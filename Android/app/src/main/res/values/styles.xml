<?xml version="1.0" encoding="utf-8"?>

<resources>

  <!--
    Miscellaneous
  -->

  <style name="AnswerButton" parent="Base_AnswerButton" />

  <style name="AnswerButtonContainer">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:paddingLeft">@dimen/edge_horizontal_margin</item>
    <item name="android:paddingRight">@dimen/edge_horizontal_margin</item>
    <item name="android:orientation">vertical</item>
    <item name="android:paddingBottom">@dimen/answer_button_container__bottom_padding</item>
    <item name="android:clipToPadding">false</item>
  </style>

  <style name="AnswerChosenStatus">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">@dimen/answer_chosen_status_text_size</item>
    <item name="android:layout_marginLeft">4dp</item>
  </style>

  <style name="Activity_Footer_Text">
    <item name="android:layout_gravity">center_horizontal</item>
    <item name="android:layout_marginTop">@dimen/content_padding_small</item>
    <item name="android:textColor">?android:attr/textColorSecondary</item>
  </style>

  <style name="ChangelogLegend">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_weight">1</item>
    <item name="android:gravity">center</item>
    <item name="android:paddingTop">@dimen/content_padding_tiny</item>
    <item name="android:paddingBottom">@dimen/content_padding_tiny</item>
    <item name="android:textColor">?android:attr/textColorPrimary</item>
  </style>

  <style name="IntersectionCarPositionNotice">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:padding">@dimen/content_padding_small</item>
    <item name="android:background">?attr/intersectionCarPositionNoticeColor</item>
  </style>

  <style name="IntersectionCarPositionNoticeText">
    <item name="android:layout_weight">1</item>
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginRight">@dimen/content_padding_small</item>
    <item name="android:textSize">@dimen/intersection_car_position_notice_text_size</item>
    <item name="android:textColor">?android:attr/textColorSecondary</item>
  </style>

  <style name="IntersectionCarPositionNoticeClose" parent="@style/Icon.Selectable">
    <item name="android:layout_width">32dp</item>
    <item name="android:layout_height">32dp</item>
    <item name="srcCompat">@drawable/ic_close</item>
    <item name="android:tint">?attr/intersectionCarPositionNoticeCloseButtonColor</item>
  </style>

  <!--
    Standard Android Views
  -->

  <style name="DrawerLayout">
    <item name="android:id">@id/drawer_layout</item>
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">match_parent</item>
    <item name="android:fitsSystemWindows">true</item>
  </style>

  <style name="NavigationView" parent="Widget.Design.NavigationView">
    <item name="android:id">@id/nav_view</item>
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">match_parent</item>
    <item name="android:layout_gravity">start</item>
    <item name="android:background">?attr/navigationDrawerBackgroundColor</item>
    <item name="android:fitsSystemWindows">true</item>
    <item name="menu">@menu/global__navigation_drawer</item>
    <item name="itemIconTint">@color/navigation_drawer__item__icon</item>
    <item name="itemTextColor">@color/navigation_drawer__item__text</item>
    <item name="headerLayout">@layout/partial_nav_header_main</item>
  </style>

  <style name="CoordinatorLayout" parent="Widget.Design.CoordinatorLayout">
    <item name="android:id">@id/coordinator_layout</item>
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">match_parent</item>
  </style>

  <style name="AppBarLayout" parent="Base.Widget.Design.AppBarLayout">
    <item name="android:id">@id/app_bar</item>
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:theme">@style/AppTheme_AppBarOverlay</item>
  </style>

  <style name="Toolbar" parent="Widget.AppCompat.Toolbar">
    <item name="android:id">@id/toolbar</item>
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">?attr/actionBarSize</item>
    <item name="android:background">?attr/colorPrimary</item>
    <item name="theme">@style/AppTheme_Toolbar</item>
    <item name="popupTheme">@style/AppTheme_PopupOverlay</item>
  </style>

  <style name="TabLayout" parent="Widget.Design.TabLayout">
    <item name="android:id">@id/tab_layout</item>
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">?attr/colorPrimary</item>
    <item name="android:minHeight">?attr/actionBarSize</item>
    <item name="tabIndicatorHeight">3dp</item>
  </style>

  <style name="ViewPager">
    <item name="android:id">@id/view_pager</item>
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="layout_behavior">@string/appbar_scrolling_view_behavior</item>
  </style>

  <style name="FloatingActionButton" parent="Widget.Design.FloatingActionButton">
    <item name="android:id">@id/fab</item>
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_gravity">bottom|end</item>
    <item name="android:layout_margin">@dimen/fab_margin</item>
    <item name="srcCompat">@drawable/ic_random_test</item>
    <!--<item name="layout_behavior">.behaviors.ScrollAwareFABBehavior</item>-->
  </style>

  <style name="BorderlessButton" parent="Widget.AppCompat.Button.Borderless">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
  </style>

  <style name="BorderlessButtonColored" parent="Widget.AppCompat.Button.Borderless.Colored">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
  </style>

  <!--
    Paper Views
  -->

  <style name="PaperSheet" parent="CardView">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="cardBackgroundColor">?attr/cardBackgroundColor</item>
    <item name="cardUseCompatPadding">true</item>
    <item name="cardCornerRadius">0dp</item>
    <item name="android:layout_marginTop">-4dp</item>
    <item name="android:layout_marginLeft">-3dp</item>
    <item name="android:layout_marginRight">-3dp</item>
    <item name="contentPaddingBottom">@dimen/edge_vertical_margin</item>
    <item name="contentPaddingLeft">@dimen/edge_horizontal_margin</item>
    <item name="contentPaddingRight">@dimen/edge_horizontal_margin</item>
    <item name="contentPaddingTop">@dimen/edge_vertical_margin</item>
  </style>

  <style name="PaperSheet.WithoutPadding">
    <item name="contentPaddingBottom">0dp</item>
    <item name="contentPaddingLeft">0dp</item>
    <item name="contentPaddingRight">0dp</item>
    <item name="contentPaddingTop">0dp</item>
  </style>

  <!--
    Separators
  -->

  <style name="Divider">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">@dimen/divider_height</item>
    <item name="android:layout_marginTop">@dimen/content_padding</item>
    <item name="android:layout_marginBottom">@dimen/content_padding</item>
    <item name="android:background">?attr/dividerColor</item>
  </style>

  <style name="Divider.Small">
    <item name="android:layout_marginTop">@dimen/content_padding_small</item>
    <item name="android:layout_marginBottom">@dimen/content_padding_small</item>
  </style>

  <style name="Divider.Visual">
    <item name="android:layout_marginTop">0dp</item>
    <item name="android:layout_marginBottom">0dp</item>
  </style>

  <style name="VerticalSpace">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">@dimen/vertical_space</item>
  </style>

  <!--
    Icons
  -->

  <style name="Icon">
    <item name="android:layout_width">36dp</item>
    <item name="android:layout_height">36dp</item>
    <item name="android:tint">?attr/iconColor</item>
  </style>

  <style name="Icon.Selectable">
    <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
  </style>

  <style name="IconSecondary">
    <item name="android:layout_width">36dp</item>
    <item name="android:layout_height">36dp</item>
    <item name="android:tint">?attr/iconColorSecondary</item>
  </style>

  <style name="IconSecondary.Selectable">
    <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
  </style>

  <style name="SocialIcon" parent="Icon.Selectable">
    <item name="android:layout_margin">@dimen/content_padding_tiny</item>
  </style>

</resources>