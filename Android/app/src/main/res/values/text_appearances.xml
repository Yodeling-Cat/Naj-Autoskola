<?xml version="1.0" encoding="utf-8"?>

<resources>

  <style name="TextAppearance" parent="TextAppearance.AppCompat.Small" />

  <style name="TextAppearance.Content_Category_Header">
    <item name="android:textColor">?android:attr/textColorPrimary</item>
    <item name="android:textSize">16sp</item>
  </style>

  <style name="TextAppearance.Content_Pair_Key">
    <item name="android:textColor">?android:attr/textColorPrimary</item>
    <item name="android:textSize">15sp</item>
  </style>

  <style name="TextAppearance.Content_Pair_Value" />

  <style name="TextAppearance.BorderlessInfoButton" parent="@style/TextAppearance.AppCompat.Widget.Button">
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:textAllCaps">false</item>
  </style>

  <!-- The parent handles the textColor and then extends the regular button textAppearance again -->
  <style name="TextAppearance.BorderlessInfoButtonColored" parent="@style/TextAppearance.AppCompat.Widget.Button.Borderless.Colored">
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:textAllCaps">false</item>
  </style>

</resources>