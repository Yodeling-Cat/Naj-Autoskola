<?xml version="1.0" encoding="utf-8"?>

<resources>

  <style name="AppTheme_Dark.NightBlue" parent="Base_AppTheme_Dark.NightBlue">

    <!--
      Application
    -->

    <item name="colorPrimary">#243447</item>
    <item name="colorPrimaryDark">#1b2836</item>
    <item name="colorAccent">#1da1f2</item>
    <item name="colorAccentFix">#1da1f2</item>
    <item name="android:windowBackground">@color/window_background__NightBlue</item>
    <item name="colorNavDrawerHeaderBackground">?attr/colorPrimary</item>
    <item name="colorCardBackground">#1b2836</item>
    <item name="colorDialogBackground">#1b2836</item>

    <!-- Widgets -->
    <item name="popupMenuStyle">@style/PopupMenu_NightBlue</item>

    <!-- Navigation Drawer -->
    <item name="colorNavigationDrawerBackground">#1b2836</item>
    <item name="colorNavigationDrawerItemText">@color/white</item>

    <!--
      Content
    -->

    <!-- Intersection Car Position Notice -->
    <item name="colorIntersectionCarPositionNotice">@color/grey_800</item>
    <item name="colorIntersectionCarPositionNoticeCloseButton">@color/grey_400</item>

    <!-- Status -->
    <item name="colorPositive">@color/light_green_A700</item>
    <item name="colorNegative">@color/red_500</item>

    <!-- Answer Button Backgrounds -->
    <item name="colorAnswerNormal">@color/colorAnswerNormal__NightBlue</item>
    <item name="colorAnswerSelected">@color/colorAnswerSelected__NightBlue</item>
    <item name="colorAnswerCorrect">@color/colorAnswerCorrect__NightBlue</item>
    <item name="colorAnswerIncorrect">@color/colorAnswerIncorrect__NightBlue</item>

    <!-- Answer Button Text -->
    <item name="colorAnswerTextNormal">@color/colorAnswerTextNormal__NightBlue</item>
    <item name="colorAnswerTextSelected">@color/colorAnswerTextSelected__NightBlue</item>

  </style>

  <!--
    Widget Themes
  -->

  <style name="PopupMenu_NightBlue" parent="Widget.AppCompat.PopupMenu">
    <item name="android:popupBackground">#1b2836</item>
  </style>

  <!--
    Application Colors
  -->

  <color name="window_background__NightBlue">#141d26</color>

  <!--
    Content Colors
  -->

  <!-- Answer Button Backgrounds -->
  <color name="colorAnswerNormal__NightBlue" type="color">@color/grey_700</color>
  <color name="colorAnswerSelected__NightBlue" type="color">@color/cyan_800</color>
  <color name="colorAnswerCorrect__NightBlue" type="color">@color/light_green_700</color>
  <color name="colorAnswerIncorrect__NightBlue" type="color">@color/cyan_800</color>

  <!-- Answer Button Text -->
  <color name="colorAnswerTextNormal__NightBlue" type="color">#ffffff</color>
  <color name="colorAnswerTextSelected__NightBlue" type="color">#ffffff</color>

</resources>