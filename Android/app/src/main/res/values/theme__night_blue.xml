<?xml version="1.0" encoding="utf-8"?>

<resources>

  <style name="AppTheme_Dark.NightBlue" parent="Base_AppTheme_Dark.NightBlue">

    <!--
      Application
    -->

    <item name="colorPrimary">#243447</item>
    <item name="colorPrimaryDark">#1b2836</item>
    <item name="colorAccent">#1da1f2</item>
    <item name="colorAccentFix">#1da1f2</item>
    <item name="android:windowBackground">@color/window_background__NightBlue</item>
    <item name="navDrawerHeaderBackgroundColor">?attr/colorPrimary</item>
    <item name="cardBackgroundColor">#1b2836</item>
    <item name="dialogBackgroundColor">#1b2836</item>

    <!-- Widgets -->
    <item name="popupMenuStyle">@style/PopupMenu_NightBlue</item>

    <!-- Navigation Drawer -->
    <item name="navigationDrawerBackgroundColor">#1b2836</item>
    <item name="navigationDrawerItemTextColor">@color/white</item>

    <!--
      Content
    -->

    <!-- Intersection Car Position Notice -->
    <item name="intersectionCarPositionNoticeColor">@color/grey_800</item>
    <item name="intersectionCarPositionNoticeCloseButtonColor">@color/grey_400</item>

    <!-- Status -->
    <item name="positiveColor">@color/light_green_A700</item>
    <item name="negativeColor">@color/red_500</item>

    <!-- Answer Button Backgrounds -->
    <item name="answerColorNormal">@color/answerColorNormal__NightBlue</item>
    <item name="answerColorSelected">@color/answerColorSelected__NightBlue</item>
    <item name="answerColorCorrect">@color/answerColorCorrect__NightBlue</item>
    <item name="answerColorIncorrect">@color/answerColorIncorrect__NightBlue</item>

    <!-- Answer Button Text -->
    <item name="answerTextColorNormal">@color/answerTextColorNormal__NightBlue</item>
    <item name="answerTextColorSelected">@color/answerTextColorSelected__NightBlue</item>

  </style>

  <!--
    Widget Themes
  -->

  <style name="PopupMenu_NightBlue" parent="Widget.AppCompat.PopupMenu">
    <item name="android:popupBackground">#1b2836</item>
  </style>

  <!--
    Application Colors
  -->

  <color name="window_background__NightBlue">#141d26</color>

  <!--
    Content Colors
  -->

  <!-- Answer Button Backgrounds -->
  <color name="answerColorNormal__NightBlue" type="color">@color/grey_700</color>
  <color name="answerColorSelected__NightBlue" type="color">@color/cyan_800</color>
  <color name="answerColorCorrect__NightBlue" type="color">@color/light_green_700</color>
  <color name="answerColorIncorrect__NightBlue" type="color">@color/cyan_800</color>

  <!-- Answer Button Text -->
  <color name="answerTextColorNormal__NightBlue" type="color">#ffffff</color>
  <color name="answerTextColorSelected__NightBlue" type="color">#ffffff</color>

</resources>