<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/remove_ads_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone"
    tools:showIn="@layout/information__activity"
    tools:visibility="visible"
    >

  <View style="@style/Divider.Visual" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:paddingBottom="@dimen/content_padding_small"
      android:paddingLeft="@dimen/content_padding"
      android:paddingRight="@dimen/content_padding"
      android:paddingTop="@dimen/content_padding_small"
      >

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        >

      <TextView
          android:id="@+id/remove_ads_title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="?android:attr/textColorPrimary"
          android:textSize="15sp"
          android:textStyle="bold"
          tools:text="Remove Ads"
          />

      <TextView
          android:id="@+id/remove_ads_description"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          tools:text="Description"
          />

    </LinearLayout>

    <Button
        android:id="@+id/purchase_remove_ads"
        android:layout_marginLeft="@dimen/content_padding"
        tools:text="€0.99"
        style="@style/PurchaseButton"
        />

  </LinearLayout>
</LinearLayout>
