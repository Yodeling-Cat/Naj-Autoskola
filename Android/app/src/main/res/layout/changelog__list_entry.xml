<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingBottom="@dimen/content_padding"
    android:paddingLeft="@dimen/edge_horizontal_margin"
    android:paddingRight="@dimen/edge_horizontal_margin"
    android:paddingTop="@dimen/content_padding"
    >

  <TextView
      android:id="@+id/changelog_header"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/content_padding"
      android:textColor="?android:attr/textColorPrimary"
      android:textSize="@dimen/changelog_text_size"
      android:textStyle="bold"
      tools:text="@string/changelog__text__changelog_header"
      />

  <TextView
      android:id="@+id/changelog"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textSize="@dimen/changelog_text_size"
      tools:text="@string/changelog__text__changes_in_v12"
      />

</LinearLayout>