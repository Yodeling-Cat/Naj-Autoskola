<!-- Content -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
			xmlns:tools="http://schemas.android.com/tools"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:scrollbars="vertical"
			tools:context=".fragments.RoadSignsDetailFragment">

	<!-- Container -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingLeft="@dimen/activity_horizontal_margin"
		android:paddingRight="@dimen/activity_horizontal_margin"
		android:paddingTop="@dimen/activity_vertical_margin"
		android:paddingBottom="@dimen/activity_vertical_margin"
		android:orientation="vertical">

		<TextView
			android:id="@+id/road_sign_name"
			style="?android:attr/textAppearanceLarge"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:textSize="19sp"
			android:layout_marginBottom="12dp"
			android:gravity="center_horizontal"
			android:text="Nebezpečensto šmyku"
			android:textIsSelectable="true" />

		<ImageView
			android:id="@+id/road_sign_image"
			android:layout_width="match_parent"
			android:layout_height="172dp"
			android:contentDescription="@null"
			android:scaleType="fitCenter"
			android:src="@drawable/road_sign" />

		<!-- Divider -->
		<View
			android:id="@+id/Divider"
			android:layout_width="match_parent"
			android:layout_height="2dp"
			android:layout_below="@id/wrapper"
			android:layout_marginTop="16dp"
			android:layout_marginBottom="16dp"
			android:background="?attr/colorDividers" />

		<TextView
			android:id="@+id/road_sign_desc"
			style="?android:attr/textAppearanceSmall"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal"
			android:text="Description"
			android:textIsSelectable="true" />

	</LinearLayout>

</ScrollView>