<!-- Content -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
			xmlns:tools="http://schemas.android.com/tools"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:scrollbars="vertical"
			tools:context=".fragments.RoadSignsDetailFragment">

	<android.support.v7.widget.CardView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginBottom="@dimen/activity_vertical_margin"
		android:layout_marginLeft="@dimen/activity_horizontal_margin"
		android:layout_marginRight="@dimen/activity_horizontal_margin"
		android:layout_marginTop="@dimen/activity_vertical_margin">

		<!-- Container -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="@dimen/card_view_padding">

			<TextView
				android:id="@+id/road_sign_name"
				style="?android:attr/textAppearanceLarge"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:gravity="center_horizontal"
				android:text="Nebezpečensto šmyku"
				android:textIsSelectable="true"
				android:textSize="19sp" />

			<ImageView
				android:id="@+id/road_sign_image"
				android:layout_width="match_parent"
				android:layout_height="172dp"
				android:contentDescription="@null"
				android:scaleType="fitCenter"
				android:src="@drawable/road_sign" />

			<!-- Divider -->
			<View
				android:id="@+id/Divider"
				android:layout_width="match_parent"
				android:layout_height="2dp"
				android:layout_below="@id/wrapper"
				android:layout_marginBottom="16dp"
				android:layout_marginTop="16dp"
				android:background="?attr/colorDividers" />

			<TextView
				android:id="@+id/road_sign_desc"
				style="?android:attr/textAppearanceSmall"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:text="Description"
				android:textIsSelectable="true" />

		</LinearLayout>

	</android.support.v7.widget.CardView>

</ScrollView>