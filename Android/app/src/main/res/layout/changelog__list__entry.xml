<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    >

  <View style="@style/Divider.Visual" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="?attr/changelogEntryBackgroundColor"
      >

    <View
        android:id="@+id/type_indicator"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:layout_marginRight="@dimen/content_padding"
        tools:background="?attr/changelogAddedColor"
        />

    <TextView
        android:id="@+id/changelog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/content_padding"
        android:layout_marginRight="@dimen/content_padding"
        android:layout_marginTop="@dimen/content_padding"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="@dimen/changelog_text_size"
        tools:text="@string/changelog__text__v12__added__most_points"
        />

  </LinearLayout>

</LinearLayout>