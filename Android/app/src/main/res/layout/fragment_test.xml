<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".TestActivityFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Content -->
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <!-- Question wrapper -->
            <LinearLayout
                android:id="@+id/wrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:minHeight="42dp"
                android:orientation="horizontal">

                <!-- Left arrow -->
                <ImageButton
                    android:id="@+id/previous_question"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_weight="0"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_keyboard_arrow_left_black_24dp"/>

                <!-- Question text-->
                <TextView
                    android:id="@+id/question_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Text otázky"
                    android:textSize="@dimen/tests_question_text_size"/>

                <!-- Right arrow -->
                <ImageButton
                    android:id="@+id/next_question"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="8dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="0"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_keyboard_arrow_right_black_24dp"/>

            </LinearLayout>

            <!-- Question image -->
            <ImageView
                android:id="@+id/question_image"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tests_image_height"
                android:layout_below="@id/wrapper"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/tests_image_margin"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/placeholder_small"
                android:visibility="visible"/>

            <!-- Buttons container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/question_image"
                android:layout_marginTop="@dimen/tests_image_margin"
                android:orientation="vertical">

                <Button
                    android:id="@+id/answer1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tests_buttons_margin"
                    android:minHeight="@dimen/tests_buttons_min_height"
                    android:text="Odpoveď č.1"
                    android:textAllCaps="false"
                    android:textSize="@dimen/tests_buttons_text_size"/>

                <Button
                    android:id="@+id/answer2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/tests_buttons_margin"
                    android:layout_marginTop="@dimen/tests_buttons_margin"
                    android:minHeight="@dimen/tests_buttons_min_height"
                    android:text="Odpoveď č.2"
                    android:textAllCaps="false"
                    android:textSize="@dimen/tests_buttons_text_size"/>

                <Button
                    android:id="@+id/answer3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/tests_buttons_margin"
                    android:minHeight="@dimen/tests_buttons_min_height"
                    android:text="Odpoveď č.3"
                    android:textAllCaps="false"
                    android:textSize="@dimen/tests_buttons_text_size"/>

            </LinearLayout>

        </RelativeLayout>

    </ScrollView>

</RelativeLayout>
