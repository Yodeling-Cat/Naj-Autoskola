<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".presentation.ui.activities.ConsentActivity"
    tools:showIn="@layout/consent__content"
    >

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      >

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vertical_space"
        android:text="@string/consent__text__section__information_collection"
        android:textColor="?android:textColorPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        />

    <View style="@style/Divider.Small" />

    <TextView
        android:id="@+id/information_collection_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="@string/consent__text__information_collection"
        />
  </LinearLayout>
</layout>
