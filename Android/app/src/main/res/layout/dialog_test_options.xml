<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
			  xmlns:tools="http://schemas.android.com/tools"
			  android:layout_width="match_parent"
			  android:layout_height="wrap_content"
			  android:orientation="vertical"
			  android:padding="24dp"
			  tools:context="activities.MainActivity">

	<!-- Otázky -->
	<RelativeLayout
		android:id="@+id/questions"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content">

		<CheckBox
			android:id="@+id/questions_checkbox"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_vertical"
			android:layout_margin="6dp"
			android:checked="true"
			android:text="@string/questions" />

	</RelativeLayout>

	<!-- Dopravné značky -->
	<RelativeLayout
		android:id="@+id/road_signs"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content">

		<CheckBox
			android:id="@+id/road_signs_checkbox"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_vertical"
			android:layout_margin="6dp"
			android:checked="true"
			android:text="@string/road_signs" />

	</RelativeLayout>

	<!-- Križovatky -->
	<RelativeLayout
		android:id="@+id/intersections"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content">

		<CheckBox
			android:id="@+id/intersections_checkbox"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_vertical"
			android:layout_margin="6dp"
			android:checked="true"
			android:text="@string/intersections" />

	</RelativeLayout>

</LinearLayout>
