<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="horizontal"
    >

  <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
      xmlns:tools="http://schemas.android.com/tools"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingBottom="@dimen/edge_vertical_margin"
      android:paddingLeft="@dimen/edge_horizontal_margin"
      android:paddingRight="@dimen/edge_horizontal_margin"
      android:paddingTop="@dimen/edge_vertical_margin"
      tools:context="activities.MainActivity"
      >

    <CheckBox
        android:id="@+id/questions_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_margin="6dp"
        android:checked="true"
        android:text="@string/questions"
        />

    <CheckBox
        android:id="@+id/road_signs_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_margin="6dp"
        android:checked="true"
        android:text="@string/road_signs"
        />

    <CheckBox
        android:id="@+id/intersections_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_margin="6dp"
        android:checked="true"
        android:text="@string/intersections"
        />

  </LinearLayout>

</ScrollView>