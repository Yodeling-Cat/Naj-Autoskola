<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".presentation.ui.activities.ConsentActivity"
    tools:showIn="@layout/consent__content"
    >

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      >

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vertical_space_large"
        android:text="@string/consent__text__section__documents"
        android:textColor="?android:textColorPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        />

    <View style="@style/Divider.Small" />

    <Button
        android:id="@+id/open_privacy_policy"
        android:layout_marginBottom="4dp"
        android:drawablePadding="8dp"
        android:text="@string/consent__button__open_privacy_policy"
        tools:drawableLeft="@drawable/ic_open_in_browser"
        style="@style/BorderlessInfoButton"
        />

    <Button
        android:id="@+id/open_terms_and_conditions"
        android:drawablePadding="8dp"
        android:text="@string/consent__button__open_terms_and_conditions"
        tools:drawableLeft="@drawable/ic_open_in_browser"
        style="@style/BorderlessInfoButton"
        />
  </LinearLayout>
</layout>
