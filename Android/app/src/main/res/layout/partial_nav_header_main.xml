<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_header_height"
    android:background="?attr/navDrawerHeaderBackgroundColor"
    android:gravity="bottom"
    android:orientation="vertical"
    android:paddingTop="@dimen/edge_vertical_margin"
    >

  <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:paddingLeft="@dimen/edge_horizontal_margin"
      android:paddingRight="@dimen/edge_horizontal_margin"
      >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.Content_Category_Header"
        />

  </LinearLayout>

  <View
      android:layout_marginTop="@dimen/edge_vertical_margin"
      style="@style/Divider.Visual"
      />

</LinearLayout>