<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_header_height"
    android:background="?attr/navDrawerHeaderBackgroundColor"
    android:gravity="bottom"
    android:orientation="vertical"
    android:paddingTop="@dimen/edge_vertical_margin"
    >

  <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginLeft="@dimen/edge_horizontal_margin"
      android:layout_marginRight="@dimen/edge_horizontal_margin"
      android:text="@string/app_name"
      android:textAppearance="@style/TextAppearance.AppCompat.Body2"
      android:textColor="?android:attr/textColorPrimary"
      />

  <TextView
      android:id="@+id/app_version"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginLeft="@dimen/edge_horizontal_margin"
      android:layout_marginRight="@dimen/edge_horizontal_margin"
      android:layout_marginTop="3dp"
      android:textColor="?android:attr/textColorSecondary"
      tools:text="@string/text__version"
      />

  <View
      android:layout_marginTop="@dimen/edge_vertical_margin"
      style="@style/Divider.Visual"
      />

</LinearLayout>