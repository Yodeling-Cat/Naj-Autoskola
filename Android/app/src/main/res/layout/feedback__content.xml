<?xml version="1.0" encoding="utf-8"?>

<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".presentation.ui.activities.FeedbackActivity"
    tools:showIn="@layout/feedback__activity"
    style="@style/CoordinatorLayout"
    >

  <include layout="@layout/feedback__app_bar" />

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:scrollbars="vertical"
      app:layout_behavior="@string/appbar_scrolling_view_behavior"
      >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >

      <android.support.design.widget.TextInputLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="@dimen/vertical_space"
          android:layout_marginLeft="@dimen/edge_horizontal_margin"
          android:layout_marginRight="@dimen/edge_horizontal_margin"
          android:layout_marginTop="@dimen/edge_vertical_margin"
          >

        <android.support.design.widget.TextInputEditText
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/feedback__hint__your_message"
            android:inputType="textMultiLine"
            />
      </android.support.design.widget.TextInputLayout>

      <CheckBox
          android:id="@+id/include_system_information"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="@dimen/vertical_space_medium"
          android:layout_marginLeft="@dimen/edge_vertical_margin"
          android:layout_marginRight="@dimen/edge_vertical_margin"
          android:checked="true"
          android:text="@string/feedback__text__include_system_information"
          />

      <android.support.v7.widget.CardView
          android:layout_marginBottom="@dimen/edge_vertical_margin"
          style="@style/PaperSheet.WithoutPadding"
          >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            >

          <Button
              android:id="@+id/show_system_info_preview"
              android:text="@string/feedback__text__preview_system_information"
              style="@style/BorderlessInfoButtonColored"
              />

          <TextView
              android:id="@+id/system_info_preview"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginBottom="@dimen/edge_vertical_margin"
              android:layout_marginLeft="@dimen/edge_vertical_margin"
              android:layout_marginRight="@dimen/edge_vertical_margin"
              android:layout_marginTop="@dimen/vertical_space"
              android:textColor="?android:attr/textColorSecondary"
              tools:text="[DEVICE]\nAPI Level 26\n..."
              />

        </LinearLayout>
      </android.support.v7.widget.CardView>

    </LinearLayout>
  </ScrollView>
</android.support.design.widget.CoordinatorLayout>