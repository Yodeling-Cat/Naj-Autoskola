<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/list_item_height"
    android:background="?android:attr/selectableItemBackground"
    >

  <TextView
      android:id="@+id/test_index"
      android:layout_width="32dp"
      android:layout_height="match_parent"
      android:layout_marginLeft="@dimen/content_padding"
      android:gravity="center"
      android:textSize="15sp"
      tools:text="1"
      tools:textColor="?android:attr/textColorPrimary"
      />

  <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center_vertical"
      android:layout_marginLeft="@dimen/content_spacing"
      android:orientation="vertical"
      >

    <TextView
        android:id="@+id/most_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="@string/tests_list__text__most_points"
        tools:textColor="?android:attr/textColorSecondary"
        />

    <TextView
        android:id="@+id/times_completed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="@string/tests_list__text__times_completed"
        tools:textColor="?android:attr/textColorSecondary"
        />

  </LinearLayout>

  <Space
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      />

  <ImageButton
      android:id="@+id/overflow_button"
      android:layout_width="42dp"
      android:layout_height="42dp"
      android:layout_gravity="center_vertical"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:contentDescription="@null"
      android:tint="?attr/iconColor"
      app:srcCompat="@drawable/ic_more_small_vert"
      />

</LinearLayout>