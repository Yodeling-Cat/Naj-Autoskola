<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/cardBackgroundColor"
    android:elevation="3dp"
    app:behavior_hideable="false"
    app:behavior_peekHeight="@dimen/tests__bottom_sheet__peek_height"
    app:layout_behavior="@string/bottom_sheet_behavior"
    tools:showIn="@layout/test__activity"
    tools:targetApi="lollipop"
    >

  <RelativeLayout
      android:layout_width="match_parent"
      android:layout_height="@dimen/tests__bottom_sheet__peek_height"
      android:background="?attr/colorPrimary"
      >

    <Chronometer
        android:id="@+id/elapsed_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:gravity="center"
        android:textColor="?attr/toolbarItemColor"
        android:textSize="@dimen/tests__statistics__important_text_size"
        />

    <TextView
        android:id="@+id/question_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginRight="@dimen/content_padding_large"
        android:layout_toLeftOf="@id/elapsed_time"
        android:textColor="?attr/toolbarItemColorSecondary"
        android:textSize="@dimen/tests__statistics__text_size"
        tools:text="1/27"
        />

    <TextView
        android:id="@+id/points_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginLeft="@dimen/content_padding_large"
        android:layout_toRightOf="@id/elapsed_time"
        android:textColor="?attr/toolbarItemColorSecondary"
        android:textSize="@dimen/tests__statistics__text_size"
        tools:text="2 body"
        />

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="-6.5dp"
        android:max="27"
        tools:progress="10"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        />

  </RelativeLayout>
</LinearLayout>
