      android:summary="@string/general_prefs__summary__cdt_as_main_group"
      android:title="@string/general_prefs__title__cdt_as_main_group" />

  <CheckBoxPreference
      android:defaultValue="true"
      android:key="keep_screen_on"
      android:summary="@string/general_prefs__summary__keep_screen_on"
