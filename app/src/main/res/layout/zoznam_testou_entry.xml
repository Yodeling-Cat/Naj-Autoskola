<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/entry"
        android:layout_width="fill_parent"
        android:layout_height="42dp"
        android:elevation="6dp"
        android:background="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:text="#1 - x4"/>

        <!-- Toggle History Icon -->
        <ImageButton
            android:id="@+id/toggle_history_icon"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_margin="6dp"
            android:background="@drawable/ic_expand_more_black_24dp"
            android:contentDescription="@string/cd_expand_test_history_icon"/>

        <!-- View Correct Answers Icon -->
        <ImageButton
            android:id="@+id/view_answers_icon"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_margin="6dp"
            android:layout_toLeftOf="@id/toggle_history_icon"
            android:layout_toStartOf="@id/toggle_history_icon"
            android:background="@drawable/ic_done_all_black_24dp"
            android:contentDescription="@string/cd_view_test_correct_answers_icon"/>

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/history"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/entry"
        android:background="@color/grey_300"
        android:visibility="visible"
        android:elevation="0dp"
        android:orientation="vertical">

        <!-- TODO: REPLACE WITH A RECYCLER VIEW -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/test_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_check_black_24dp"
                android:layout_marginStart="6dp"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="6dp"/>

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/test_status"
                android:layout_marginTop="6dp"
                android:layout_marginStart="6dp"
                android:layout_marginLeft="6dp"
                android:text="50 b."/>

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                android:layout_marginRight="6dp"
                android:text="13:27"/>

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                android:layout_marginRight="6dp"
                android:text="29.9 | 12:25"/>

        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>