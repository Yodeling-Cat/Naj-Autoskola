<?xml version="1.0" encoding="utf-8"?>

<!-- TODO: IS THIS ELEMENT EVEN CLICK-ABLE?? -->
<RelativeLayout
    android:id="@+id/test_entry"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="42dp">

    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:text="#1 - x4"/>

    <!-- Expand Test History Icon -->
    <ImageButton
        android:id="@+id/expand_history_icon"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_margin="6dp"
        android:background="@drawable/ic_expand_more_black_24dp"
        android:contentDescription="@string/cd_expand_test_history_icon"/>

    <!-- View Correct Answers Icon -->
    <ImageButton
        android:id="@+id/view_answers_icon"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"
        android:layout_margin="6dp"
        android:layout_toLeftOf="@id/expand_history_icon"
        android:layout_toStartOf="@id/expand_history_icon"
        android:background="@drawable/ic_done_all_black_24dp"
        android:contentDescription="@string/cd_view_test_correct_answers_icon"/>

</RelativeLayout>