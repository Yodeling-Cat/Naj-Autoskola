<?xml version="1.0" encoding="utf-8"?>

<android.support.v7.widget.CardView
    android:id="@+id/card_view"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card_view:cardBackgroundColor="?attr/colorCardBackground"
    card_view:cardCornerRadius="4dp"
    tools:context=".VyberTestuFragment">

    <!-- Title bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/colorSecondary"
        android:gravity="center_vertical">

        <!-- Category icon -->
        <ImageView
            android:id="@+id/title_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_margin="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_help_black_24dp"/>

        <!-- Card title -->
        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_toEndOf="@id/title_icon"
            android:layout_toRightOf="@id/title_icon"
            android:gravity="center_vertical"
            android:text="@string/moznosti_testu"
            android:textColor="#FFEE58"
            android:textSize="16sp"
            android:textStyle="bold"/>

    </RelativeLayout>

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:orientation="vertical">

        <!-- Otázky -->
        <RelativeLayout
            android:id="@+id/otazky"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">

            <CheckBox
                android:id="@+id/otazky_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_margin="6dp"
                android:checked="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_toEndOf="@id/otazky_checkbox"
                android:layout_toRightOf="@id/otazky_checkbox"
                android:text="@string/otazky"/>

        </RelativeLayout>

        <!-- Dopravné značky -->
        <RelativeLayout
            android:id="@+id/dopravne_znacky"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">

            <CheckBox
                android:id="@+id/dopravne_znacky_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_margin="6dp"
                android:checked="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_toEndOf="@id/dopravne_znacky_checkbox"
                android:layout_toRightOf="@id/dopravne_znacky_checkbox"
                android:text="@string/dopravne_znacky"/>

        </RelativeLayout>

        <!-- Križovatky -->
        <RelativeLayout
            android:id="@+id/krizovatky"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">

            <CheckBox
                android:id="@+id/krizovatky_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_margin="6dp"
                android:checked="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_toEndOf="@id/krizovatky_checkbox"
                android:layout_toRightOf="@id/krizovatky_checkbox"
                android:text="@string/krizovatky"/>

        </RelativeLayout>

        <!-- Separator -->
        <!--<View
            android:layout_width="fill_parent"
            android:layout_height="2dp"
            android:background="@color/grey_300"/>-->

