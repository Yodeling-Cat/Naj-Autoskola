<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.spiracle.drivingschool" >

	<!-- Include required permissions for Google Mobile Ads to run-->
	<uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <application
        android:icon="@drawable/launcher_icon"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
		android:allowBackup="true">
		<!--This meta-data tag is required to use Google Play Services.-->
		<meta-data android:name="com.google.android.gms.version"
				   android:value="@integer/google_play_services_version" />

        <activity
            android:name="com.spiracle.drivingschool.ActivityMain"
            android:label="@string/app_name" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.spiracle.drivingschool.ActivityAddPerson"
            android:label="@string/title_activity_add_person" >
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="com.spiracle.drivingschool.ActivityMain" />
        </activity>
		<activity
			android:name="com.spiracle.drivingschool.ActivityEditPerson"
			android:label="@string/title_activity_edit_person" >
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value="com.spiracle.drivingschool.ActivityMain" />
		</activity>
        <activity
            android:name="com.spiracle.drivingschool.ActivitySettings"
            android:label="@string/title_activity_settings" >
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="com.spiracle.drivingschool.ActivityMain" />
        </activity>
		<!--Include the AdActivity configChanges and theme. -->
		<activity android:name="com.google.android.gms.ads.AdActivity"
				  android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
				  android:theme="@android:style/Theme.Translucent" />
    </application>

</manifest>
