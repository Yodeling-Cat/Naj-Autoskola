<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.spiracle.paymentapp" >

    <application
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme" >
        <activity
            android:name=".ActivityMain"
            android:label="@string/app_name" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ActivityAddPerson"
            android:label="@string/title_activity_add_person" >
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="com.spiracle.paymentapp.ActivityMain" />
        </activity>
		<activity
			android:name=".ActivityEditPerson"
			android:label="@string/title_activity_edit_person" >
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value="com.spiracle.paymentapp.ActivityMain" />
		</activity>
        <activity
            android:name=".ActivitySettings"
            android:label="@string/title_activity_settings" >
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="com.spiracle.paymentapp.ActivityMain" />
        </activity>
    </application>

</manifest>

